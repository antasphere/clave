<?xml version="1.0" encoding="utf-8"?>
<!-- The RELEASE build: https everywhere, no cleartext to any host, the system's trust store. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
