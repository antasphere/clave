<?xml version="1.0" encoding="utf-8"?>
<!-- Up to Android 11, android:allowBackup="false" already stops every backup and transfer; these
     rules say the same should that attribute ever change: every domain excluded. From Android 12
     data_extraction_rules.xml governs. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
