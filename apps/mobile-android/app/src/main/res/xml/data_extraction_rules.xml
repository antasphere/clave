<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of this app leaves the phone: no cloud backup and no device-to-device transfer.
     android:allowBackup="false" stops both up to Android 11; from Android 12 it no longer stops
     a device-to-device transfer, and these rules do. The credentials could not travel usefully
     (their key never leaves the Keystore), but the plain store holds the drafts, the ledger of
     unsent messages with their text, the pairing records and the machine cache, and Firebase
     keeps its registration beside them. Every domain is excluded from both. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
