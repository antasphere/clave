<?xml version="1.0" encoding="utf-8"?>
<!-- The test app may reach the network so Coil fails an unreachable image the way the app
     does (a DNS miss drawn as the placeholder) instead of a SecurityException crashing the run. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
