{
  "id": "clave.hello",
  "name": "Hello Clave",
  "version": "1.0.0",
  "kind": "plugin",
  "engines": { "clave": ">=1.90.0 <3.0.0" },
  "ui": "surface",
  "main": "main.mjs",
  "uiEntry": "ui/index.html",
  "contributes": {
    "panels": [
      { "id": "hello", "title": "Hello panel", "icon": "HandRaisedIcon", "placement": "side" },
      { "id": "hello-main", "title": "Hello main", "icon": "SparklesIcon", "placement": "main" }
    ],
    "commands": [
      { "id": "say-hello", "title": "Say hello" },
      { "id": "wave", "title": "Wave" },
      { "id": "pushed-context", "title": "Pushed context" },
      { "id": "focused-session", "title": "Focused session" }
    ],
    "toolbar": [
      { "id": "wave", "title": "Wave", "icon": "HandRaisedIcon", "kind": "action" },
      {
        "id": "hello-menu",
        "title": "Hello menu",
        "icon": "SparklesIcon",
        "kind": "popover",
        "items": [
          { "id": "say-hello", "title": "Say hello" },
          { "id": "pushed-context", "title": "Pushed context" },
          { "id": "focused-session", "title": "Focused session" }
        ]
      }
    ]
  },
  "permissions": ["sessions.read"]
}
