{
  "name": "@clave/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Clave on the phone: the sessions running at home, their conversations, the agents' requests, a launch from a saved profile. React Native with Expo, in this repository, built locally (no build service).",
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --port 8081",
    "ios": "expo run:ios --device \"iPhone 17 Pro\"",
    "android": "expo run:android",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "export": "expo export --platform ios --output-dir dist",
    "check:release-bundle": "node scripts/check-release-bundle.mjs",
    "check:simulator": "node scripts/simulator-check.mjs",
    "dev:server": "node scripts/dev-server.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "expo": "58.0.21",
    "expo-constants": "58.0.14",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.4",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "ws": "8.19.0"
  }
}
