  "constants": {
    "MAX_TRANSFER_BYTES": 5242880,
    "MAX_TEXT_BYTES": 1048576,
    "MAX_PREVIEW_BYTES": 16384,
    "MAX_BASE64_LENGTH": 6990508,
    "MAX_FILE_ENTRIES": 5000,
    "FILE_TREE_IGNORED": [
      "node_modules",
      ".git",
      "dist",
      "build",
