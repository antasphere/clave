    "./push": "./src/push.ts",
    "./sessions": "./src/sessions.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform": "0.97.1",
    "@structure-ai/cqrs": "0.2.1",
    "@structure-ai/http": "0.2.1",
    "effect": "3.22.1"
  }
}
