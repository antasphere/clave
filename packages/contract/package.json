    "./errors": "./src/errors.ts",
    "./events": "./src/events.ts",
    "./push": "./src/push.ts",
    "./forward": "./src/forward.ts",
    "./sessions": "./src/sessions.ts",
    "./work": "./src/work.ts",
    "./work-rules": "./src/work-rules.ts",
    "./settings": "./src/settings/index.ts",
    "./sidebar": "./src/sidebar/index.ts",
    "./sidebar/ops": "./src/sidebar/ops.ts",
    "./workspace-files": "./src/workspace-files/index.ts",
    "./views": "./src/views.ts",
    "./view-deadlines": "./src/view-deadlines.ts",
    "./agent-tools": "./src/agent-tools.ts",
    "./plugins": "./src/plugins.ts",
    "./files": "./src/files.ts",
