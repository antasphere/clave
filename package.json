{
  "name": "clave",
  "version": "1.90.2",
  "description": "Manage multiple Claude Code sessions from a single desktop app",
  "author": "Codika <hello@codika.io> (https://codika.io)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antasphere/clave.git"
  },
  "homepage": "https://github.com/antasphere/clave",
  "main": "./out/main/index.js",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "npm run native:build && electron-vite dev",
    "native:build": "bash scripts/build-native.sh",
    "build": "npm run native:build && npm run typecheck && electron-vite build",
    "postinstall": "node scripts/postinstall.cjs",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run typecheck && electron-vite build && electron-builder --win",
    "build:mac": "npm run native:build && electron-vite build && electron-builder --mac",
    "build:mac:test": "bash scripts/build-mac-local-test.sh",
    "build:linux": "electron-vite build && electron-builder --linux",
    "release": "bash scripts/release.sh",
    "test": "node packages/ui/scripts/check-tokens.mjs && vitest run",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "dependencies": {
    "@clave/plugin-sdk": "*",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/geist-sans": "^5.2.5",
    "@heroicons/react": "^2.2.0",
    "@lezer/highlight": "^1.2.3",
    "@mdxeditor/editor": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@resvg/resvg-js": "^2.6.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.7.3",
    "fast-glob": "^3.3.3",
    "framer-motion": "^12.34.0",
    "htmlparser2": "^12.0.0",
    "node-pty": "^1.1.0",
    "nodemailer": "^10.0.1",
    "postcss": "^8.5.28",
    "postcss-value-parser": "^4.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.7",
    "semver": "^7.8.5",
    "shiki": "^3.22.0",
    "simple-git": "^3.31.1",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.5.0",
    "ws": "^8.19.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.19.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@types/semver": "^7.8.0",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "playwright-core": "^1.56.1",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^3.2.7"
  },
  "workspaces": [
    "packages/ui",
    "packages/plugin-sdk",
    "packages/skins"
  ]
}
